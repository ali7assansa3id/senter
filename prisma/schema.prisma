// SENTER Phase 1 — Prisma Schema
// وفق SRS v1.0 | Tenant isolation (BR-001) | Soft Delete (BR-002) | Africa/Cairo

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth & RBAC ───────────────────────────────────────────

model User {
  id                   String    @id @default(uuid())
  email                String?   @unique
  phone                String?   @unique
  passwordHash         String    @map("password_hash")
  fullName             String    @map("full_name")
  avatarUrl            String?   @map("avatar_url")
  status               String    @default("active") // active | locked | inactive
  failedLoginAttempts  Int       @default(0) @map("failed_login_attempts")
  lockedUntil          DateTime? @map("locked_until")
  preferredLocale      String    @default("ar") @map("preferred_locale")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  deletedAt            DateTime? @map("deleted_at")

  userRoles            UserRole[]
  sessions             Session[]
  ownedCenters         Center[]  @relation("CenterOwner")
  auditLogs            AuditLog[]
  createdStudents      Student[] @relation("StudentCreator")
  attendanceRecords    AttendanceRecord[] @relation("AttendanceRecorder")

  @@map("users")
}

model Role {
  id           String   @id @default(uuid())
  name         String   // center_owner | branch_manager | staff | accountant | teacher | student | parent
  scope        String   // platform | center
  descriptionAr String? @map("description_ar")
  createdAt    DateTime @default(now()) @map("created_at")

  userRoles        UserRole[]
  rolePermissions  RolePermission[]

  @@map("roles")
}

model Permission {
  id            String  @id @default(uuid())
  code          String  @unique // e.g. students.create
  descriptionAr String? @map("description_ar")
  module        String?

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  roleId    String    @map("role_id")
  tenantId  String?   @map("tenant_id") // center_id
  branchId  String?   @map("branch_id")
  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@map("user_roles")
}

model Session {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  deviceInfo String?   @map("device_info")
  ipAddress  String?   @map("ip_address")
  userAgent  String?   @map("user_agent")
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  revokedAt  DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String?  @map("tenant_id")
  userId     String?  @map("user_id")
  action     String
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

// ─── Centers ───────────────────────────────────────────────

model Center {
  id             String    @id @default(uuid())
  ownerUserId    String    @map("owner_user_id")
  name           String
  description    String?
  address        String?
  governorate    String?
  city           String?
  phone          String?
  email          String?
  licenseNumber  String?   @map("license_number")
  logoUrl        String?   @map("logo_url")
  primaryColor   String    @default("#1E40AF") @map("primary_color")
  secondaryColor String    @default("#3B82F6") @map("secondary_color")
  status         String    @default("active")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  owner    User     @relation("CenterOwner", fields: [ownerUserId], references: [id])
  branches Branch[]
  students Student[]
  parents  Parent[]
  teachers Teacher[]
  subjects Subject[]
  groups   Group[]

  @@map("centers")
}

model Branch {
  id            String    @id @default(uuid())
  centerId      String    @map("center_id")
  name          String
  address       String?
  managerUserId String?   @map("manager_user_id")
  status        String    @default("active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  center Center @relation(fields: [centerId], references: [id])
  rooms  Room[]
  groups Group[]

  @@map("branches")
}

model Room {
  id             String    @id @default(uuid())
  branchId       String    @map("branch_id")
  name           String
  capacity       Int?
  facilitiesJson Json?     @default("[]") @map("facilities_json")
  status         String    @default("active")
  createdAt      DateTime  @default(now()) @map("created_at")
  deletedAt      DateTime? @map("deleted_at")

  branch Branch  @relation(fields: [branchId], references: [id])
  groups Group[]

  @@map("rooms")
}

// ─── Students & Parents ────────────────────────────────────

model Parent {
  id        String    @id @default(uuid())
  centerId  String    @map("center_id")
  userId    String?   @map("user_id")
  fullName  String    @map("full_name")
  phone     String
  relation  String?   // أب، أم، وصي
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  center         Center          @relation(fields: [centerId], references: [id])
  studentParents StudentParent[]

  @@index([centerId, phone])
  @@map("parents")
}

model Student {
  id          String    @id @default(uuid())
  centerId    String    @map("center_id")
  code        String?
  fullName    String    @map("full_name")
  birthDate   DateTime? @map("birth_date") @db.Date
  gradeLevel  String    @map("grade_level")
  classYear   String    @map("class_year")
  nationalId  String?   @map("national_id")
  avatarUrl   String?   @map("avatar_url")
  phone       String?
  status      String    @default("active") // active | paused | withdrawn | graduated
  branchId    String?   @map("branch_id")
  notes       String?
  createdById String?   @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  center         Center              @relation(fields: [centerId], references: [id])
  createdBy      User?               @relation("StudentCreator", fields: [createdById], references: [id])
  studentParents StudentParent[]
  groupStudents  GroupStudent[]
  attendance     AttendanceRecord[]

  @@index([centerId, status])
  @@map("students")
}

model StudentParent {
  studentId String  @map("student_id")
  parentId  String  @map("parent_id")
  isPrimary Boolean @default(false) @map("is_primary")

  student Student @relation(fields: [studentId], references: [id])
  parent  Parent  @relation(fields: [parentId], references: [id])

  @@id([studentId, parentId])
  @@map("student_parents")
}

// ─── Teachers ──────────────────────────────────────────────

model Teacher {
  id               String    @id @default(uuid())
  centerId         String?   @map("center_id")
  userId           String?   @map("user_id")
  fullName         String    @map("full_name")
  phone            String?
  email            String?
  specialtiesJson  Json?     @default("[]") @map("specialties_json")
  subjectsJson     Json?     @default("[]") @map("subjects_json")
  gradeLevelsJson  Json?     @default("[]") @map("grade_levels_json")
  bio              String?
  avatarUrl        String?   @map("avatar_url")
  status           String    @default("active")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  center              Center?                     @relation(fields: [centerId], references: [id])
  compensationModels  TeacherCompensationModel[]
  groups              Group[]

  @@map("teachers")
}

model TeacherCompensationModel {
  id          String   @id @default(uuid())
  teacherId   String   @map("teacher_id")
  modelType   String   @map("model_type") // fixed_per_session | percentage | per_student | custom
  value       Decimal  @db.Decimal(12, 2)
  currency    String   @default("EGP")
  notes       String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  teacher Teacher @relation(fields: [teacherId], references: [id])

  @@map("teacher_compensation_models")
}

// ─── Groups & Schedules ────────────────────────────────────

model Subject {
  id        String    @id @default(uuid())
  centerId  String    @map("center_id")
  name      String
  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  center Center  @relation(fields: [centerId], references: [id])
  groups Group[]

  @@map("subjects")
}

model Group {
  id                        String    @id @default(uuid())
  centerId                  String    @map("center_id")
  branchId                  String?   @map("branch_id")
  subjectId                 String?   @map("subject_id")
  name                      String
  gradeLevel                String?   @map("grade_level")
  teacherId                 String?   @map("teacher_id")
  roomId                    String?   @map("room_id")
  maxStudents               Int?      @map("max_students")
  defaultSubscriptionType   String?   @map("default_subscription_type")
  status                    String    @default("active")
  createdAt                 DateTime  @default(now()) @map("created_at")
  updatedAt                 DateTime  @updatedAt @map("updated_at")
  deletedAt                 DateTime? @map("deleted_at")

  center        Center         @relation(fields: [centerId], references: [id])
  branch        Branch?        @relation(fields: [branchId], references: [id])
  subject       Subject?       @relation(fields: [subjectId], references: [id])
  teacher       Teacher?       @relation(fields: [teacherId], references: [id])
  room          Room?          @relation(fields: [roomId], references: [id])
  schedules     GroupSchedule[]
  groupStudents GroupStudent[]
  sessions      SessionClass[]

  @@map("groups")
}

model GroupStudent {
  groupId   String    @map("group_id")
  studentId String    @map("student_id")
  joinedAt  DateTime  @default(now()) @map("joined_at") @db.Date
  leftAt    DateTime? @map("left_at") @db.Date
  status    String    @default("active")

  group   Group   @relation(fields: [groupId], references: [id])
  student Student @relation(fields: [studentId], references: [id])

  @@id([groupId, studentId, joinedAt])
  @@map("group_students")
}

model GroupSchedule {
  id        String @id @default(uuid())
  groupId   String @map("group_id")
  dayOfWeek Int    @map("day_of_week") // 0=Sunday ... 6=Saturday
  startTime String @map("start_time")  // HH:mm
  endTime   String @map("end_time")

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@map("group_schedules")
}

model SessionClass {
  id          String    @id @default(uuid())
  groupId     String    @map("group_id")
  scheduledAt DateTime  @map("scheduled_at")
  status      String    @default("scheduled") // scheduled | held | cancelled | makeup
  notes       String?
  createdAt   DateTime  @default(now()) @map("created_at")
  deletedAt   DateTime? @map("deleted_at")

  group      Group               @relation(fields: [groupId], references: [id])
  attendance AttendanceRecord[]

  @@map("sessions")
}

// ─── Attendance (FR-050, FR-052, FR-053, FR-054) ───────────

model AttendanceRecord {
  id              String    @id @default(uuid())
  sessionId       String    @map("session_id")
  studentId       String    @map("student_id")
  status          String    // present | absent | late | excused
  recordedById    String?   @map("recorded_by")
  notes           String?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  session    SessionClass @relation(fields: [sessionId], references: [id])
  student    Student      @relation(fields: [studentId], references: [id])
  recordedBy User?        @relation("AttendanceRecorder", fields: [recordedById], references: [id])
  audits     AttendanceAudit[]

  @@unique([sessionId, studentId]) // BR-003
  @@map("attendance_records")
}

model AttendanceAudit {
  id           String   @id @default(uuid())
  attendanceId String   @map("attendance_id")
  oldStatus    String?  @map("old_status")
  newStatus    String   @map("new_status")
  reason       String?
  changedById  String?  @map("changed_by")
  createdAt    DateTime @default(now()) @map("created_at")

  attendance AttendanceRecord @relation(fields: [attendanceId], references: [id], onDelete: Cascade)

  @@map("attendance_audit")
}

model Notification {
  id        String    @id @default(uuid())
  tenantId  String?   @map("tenant_id")
  userId    String    @map("user_id")
  type      String    // absence_alert | ...
  title     String
  body      String
  dataJson  Json?     @map("data_json")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("notifications")
}
